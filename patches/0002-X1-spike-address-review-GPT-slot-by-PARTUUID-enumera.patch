 typedef struct _LXSS_DISTRO_CONFIGURATION
diff --git a/src/windows/service/exe/LxssUserSession.cpp b/src/windows/service/exe/LxssUserSession.cpp
index 899d81c..70da5b5 100644
--- a/src/windows/service/exe/LxssUserSession.cpp
+++ b/src/windows/service/exe/LxssUserSession.cpp
@@ -4173,30 +4173,38 @@ LxssUserSessionImpl::s_GetDistributionConfiguration(const DistributionRegistrati
         const auto keyPath = std::format(
             L"SOFTWARE\\X1Unified\\PhysicalRoots\\{}", wsl::shared::string::GuidToString<wchar_t>(configuration.DistroId));
 
+        // N.B. An invalid authorization is recorded instead of thrown so enumeration of other distros keeps working;
+        // the launch of this distro is refused and never falls back to a VHD.
         wil::unique_hkey physicalKey;
         const auto status = RegOpenKeyExW(HKEY_LOCAL_MACHINE, keyPath.c_str(), 0, KEY_READ, &physicalKey);
         if (status != ERROR_FILE_NOT_FOUND)
         {
-            THROW_IF_WIN32_ERROR(status);
-
-            const auto read = [&](LPCWSTR name) {
-                return wsl::windows::common::registry::ReadString(physicalKey.get(), nullptr, name, L"");
-            };
-
             LXSS_PHYSICAL_ROOT physical{};
-            physical.Model = read(L"Model");
-            physical.Serial = read(L"Serial");
-            physical.UserSid = read(L"UserSid");
-            const auto partitionGuid = wsl::shared::string::ToGuid(read(L"PartitionGuid"));
-            physical.Ext4Uuid = wsl::windows::common::string::WideToMultiByte(read(L"Ext4Uuid"));
-            THROW_HR_IF_MSG(
-                E_INVALIDARG,
-                !partitionGuid.has_value() || physical.Model.empty() || physical.Serial.empty() || physical.UserSid.empty() ||
-                    physical.Ext4Uuid.size() != 32 ||
-                    !std::ranges::all_of(physical.Ext4Uuid, [](char c) { return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'); }),
-                "Incomplete X1 physical root authorization");
-
-            physical.PartitionGuid = partitionGuid.value();
+            try
+            {
+                THROW_IF_WIN32_ERROR(status);
+
+                const auto read = [&](LPCWSTR name) {
+                    return wsl::windows::common::registry::ReadString(physicalKey.get(), nullptr, name, L"");
+                };
+
+                physical.Model = read(L"Model");
+                physical.Serial = read(L"Serial");
+                physical.UserSid = read(L"UserSid");
+                const auto partitionGuid = wsl::shared::string::ToGuid(read(L"PartitionGuid"));
+                physical.Ext4Uuid = wsl::windows::common::string::WideToMultiByte(read(L"Ext4Uuid"));
+                physical.Valid = partitionGuid.has_value() && !physical.Model.empty() && !physical.Serial.empty() &&
+                                 !physical.UserSid.empty() && physical.Ext4Uuid.size() == 32 &&
+                                 std::ranges::all_of(physical.Ext4Uuid, [](char c) { return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'); });
+
+                physical.PartitionGuid = partitionGuid.value_or(GUID{});
+            }
+            catch (...)
+            {
+                LOG_CAUGHT_EXCEPTION_MSG("Failed to read X1 physical root authorization");
+                physical.Valid = false;
+            }
+
             configuration.PhysicalRoot = std::move(physical);
         }
     }
diff --git a/src/windows/service/exe/WslCoreVm.cpp b/src/windows/service/exe/WslCoreVm.cpp

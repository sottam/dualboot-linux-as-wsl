From ffb21c79d2cf62d44eef88b1718950ad844abea4 Mon Sep 17 00:00:00 2001
From: Alonso Matos <github@sttm.com.br>
Date: Fri, 23 Oct 2026 00:47:45 -0300
Subject: [PATCH 2/6] X1 spike: address review (GPT slot by PARTUUID,
 enumeration, strict parsing)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/linux/init/main.cpp                     | 86 ++++++++++++++++++---
 src/windows/service/exe/LxssCreateProcess.h |  1 +
 src/windows/service/exe/LxssUserSession.cpp | 46 ++++++-----
 src/windows/service/exe/WslCoreVm.cpp       | 44 +++++++----
 4 files changed, 133 insertions(+), 44 deletions(-)

diff --git a/src/linux/init/main.cpp b/src/linux/init/main.cpp
index c593975..5cd2598 100644
--- a/src/linux/init/main.cpp
+++ b/src/linux/init/main.cpp
@@ -2283,7 +2283,10 @@ void ProcessLaunchInitMessage(
 
         if (*PhysicalRoot != '\0')
         {
-            THROW_ERRNO_IF(EINVAL, Message->MountDeviceType != LxMiniInitMountDeviceTypeLun || (Message->Flags & LxMiniInitMessageFlagCreateOverlayFs));
+            THROW_ERRNO_IF(
+                EINVAL,
+                Message->MountDeviceType != LxMiniInitMountDeviceTypeLun ||
+                    (Message->Flags & (LxMiniInitMessageFlagCreateOverlayFs | LxMiniInitMessageFlagMountReadOnly)));
             THROW_LAST_ERROR_IF(MountPhysicalRoot(Message->DeviceId, PhysicalRoot, DISTRO_PATH, FsType, MountOptions) < 0);
         }
         else
@@ -3772,13 +3775,14 @@ int MountPhysicalRoot(unsigned int Lun, const char* PhysicalRoot, const char* Ta
 Routine Description:
 
     X1: mounts the root partition of a pass-through physical disk. The service already matched the disk identity and
-    PARTUUID on Windows; this routine checks the ext4 superblock UUID before mounting and the mount source after.
+    PARTUUID on Windows; this routine locates the GPT slot with that PARTUUID inside the LUN, checks the ext4
+    superblock UUID before mounting and the mount source after.
 
 Arguments:
 
     Lun - Supplies the LUN of the pass-through disk.
 
-    PhysicalRoot - Supplies "<partition number>:<ext4 uuid as 32 lowercase hex digits>".
+    PhysicalRoot - Supplies "<PARTUUID as its 16 on-disk GPT bytes>:<ext4 uuid>", both as 32 lowercase hex digits.
 
     Target - Supplies the target of the mount.
 
@@ -3794,15 +3798,79 @@ Return Value:
 
 try
 {
+    const auto IsHex = [](std::string_view Value) {
+        return Value.size() == 32 && std::ranges::all_of(Value, [](char c) { return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'); });
+    };
+
+    const auto ToHex = [](const uint8_t* Bytes, size_t Size) {
+        std::string Hex;
+        for (size_t Index = 0; Index < Size; Index++)
+        {
+            Hex += std::format("{:02x}", Bytes[Index]);
+        }
+
+        return Hex;
+    };
+
     const std::string_view Spec{PhysicalRoot};
-    const auto Separator = Spec.find(':');
-    THROW_ERRNO_IF(EINVAL, Separator == Spec.npos || Separator == 0 || Spec.size() - Separator - 1 != 32);
+    THROW_ERRNO_IF(EINVAL, Spec.size() != 65 || Spec[32] != ':' || !IsHex(Spec.substr(0, 32)) || !IsHex(Spec.substr(33)));
+
+    const std::string ExpectedPartUuid{Spec.substr(0, 32)};
+    const std::string ExpectedUuid{Spec.substr(33)};
+
+    //
+    // Locate the GPT slot with the authorized PARTUUID. Linux names partitions after their slot index, which can
+    // differ from the Windows partition number.
+    //
+
+    const auto DiskPath = GetLunDevicePath(Lun);
+    WaitForBlockDevice(DiskPath.c_str());
+
+    unsigned int Partition = 0;
+    {
+        wil::unique_fd Disk{open(DiskPath.c_str(), (O_RDONLY | O_CLOEXEC))};
+        THROW_LAST_ERROR_IF(!Disk);
+
+        int SectorSize = 0;
+        THROW_LAST_ERROR_IF(ioctl(Disk.get(), BLKSSZGET, &SectorSize) < 0);
+        THROW_ERRNO_IF(EINVAL, SectorSize < 512 || SectorSize > 4096);
+
+        std::vector<uint8_t> Header(SectorSize);
+        THROW_ERRNO_IF(EIO, pread(Disk.get(), Header.data(), Header.size(), SectorSize) != static_cast<ssize_t>(Header.size()));
+        THROW_ERRNO_IF(EINVAL, memcmp(Header.data(), "EFI PART", 8) != 0);
+
+        uint64_t EntriesLba{};
+        uint32_t EntryCount{};
+        uint32_t EntrySize{};
+        memcpy(&EntriesLba, Header.data() + 72, sizeof(EntriesLba));
+        memcpy(&EntryCount, Header.data() + 80, sizeof(EntryCount));
+        memcpy(&EntrySize, Header.data() + 84, sizeof(EntrySize));
+        THROW_ERRNO_IF(EINVAL, EntryCount == 0 || EntryCount > 1024 || EntrySize < 128 || EntrySize > 4096);
 
-    const auto Partition = std::stoul(std::string{Spec.substr(0, Separator)});
-    const std::string ExpectedUuid{Spec.substr(Separator + 1)};
-    THROW_ERRNO_IF(EINVAL, Partition == 0);
+        std::vector<uint8_t> Entries(static_cast<size_t>(EntryCount) * EntrySize);
+        THROW_ERRNO_IF(
+            EIO, pread(Disk.get(), Entries.data(), Entries.size(), static_cast<off_t>(EntriesLba * SectorSize)) != static_cast<ssize_t>(Entries.size()));
+
+        constexpr std::string_view LinuxFilesystemType = "af3dc60f838472478e793d69d8477de4";
+        for (uint32_t Index = 0; Index < EntryCount; Index++)
+        {
+            const auto* Entry = Entries.data() + static_cast<size_t>(Index) * EntrySize;
+            if (ToHex(Entry + 16, 16) == ExpectedPartUuid)
+            {
+                THROW_ERRNO_IF(EEXIST, Partition != 0);
+                THROW_ERRNO_IF(EINVAL, ToHex(Entry, 16) != LinuxFilesystemType);
+                Partition = Index + 1;
+            }
+        }
+
+        if (Partition == 0)
+        {
+            LOG_ERROR("Physical root PARTUUID not found on {}", DiskPath);
+            THROW_ERRNO(ENOENT);
+        }
+    }
 
-    const auto DevicePath = std::format("{}{}", GetLunDevicePath(Lun), Partition);
+    const auto DevicePath = std::format("{}{}", DiskPath, Partition);
     WaitForBlockDevice(DevicePath.c_str());
 
     {
diff --git a/src/windows/service/exe/LxssCreateProcess.h b/src/windows/service/exe/LxssCreateProcess.h

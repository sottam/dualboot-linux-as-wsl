From 406ac9f234f5c9ed4e7b0f5729e1f372b7a97958 Mon Sep 17 00:00:00 2001
From: Alonso Matos <github@sttm.com.br>
Date: Sat, 24 Oct 2026 13:04:01 -0300
Subject: [PATCH 4/6] X1 S6: refuse image operations, reuse root LUN after
 terminate, bind the ext4 gate to boot

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/linux/init/main.cpp                     | 77 +++++++++++++++++++--
 src/windows/service/exe/LxssCreateProcess.h |  5 ++
 src/windows/service/exe/LxssUserSession.cpp | 21 +++++-
 src/windows/service/exe/WslCoreVm.cpp       | 19 ++++-
 4 files changed, 114 insertions(+), 8 deletions(-)

diff --git a/src/linux/init/main.cpp b/src/linux/init/main.cpp
index 5cd2598..2538628 100644
--- a/src/linux/init/main.cpp
+++ b/src/linux/init/main.cpp
@@ -53,6 +53,7 @@ Abstract:
 #include <unistd.h>
 #include <utmp.h>
 #include <assert.h>
+#include <charconv>
 #include "configfile.h"
 #include "lxfsshares.h"
 #include "common.h"
@@ -3782,7 +3783,9 @@ Arguments:
 
     Lun - Supplies the LUN of the pass-through disk.
 
-    PhysicalRoot - Supplies "<PARTUUID as its 16 on-disk GPT bytes>:<ext4 uuid>", both as 32 lowercase hex digits.
+    PhysicalRoot - Supplies "<PARTUUID>:<ext4 uuid>:<compat>:<incompat>:<ro_compat>:<kernel release>". PARTUUID (its
+        16 on-disk GPT bytes) and UUID are 32 lowercase hex digits; the three reviewed ext4 feature masks are 8
+        lowercase hex digits; the kernel release is the one the ext4 gate was reviewed against.
 
     Target - Supplies the target of the mount.
 
@@ -3812,11 +3815,42 @@ try
         return Hex;
     };
 
+    const auto ToMask = [](std::string_view Value) {
+        uint32_t Mask{};
+        const auto Result = std::from_chars(Value.data(), Value.data() + Value.size(), Mask, 16);
+        THROW_ERRNO_IF(EINVAL, Value.size() != 8 || Result.ec != std::errc{} || Result.ptr != Value.data() + Value.size());
+        return Mask;
+    };
+
     const std::string_view Spec{PhysicalRoot};
-    THROW_ERRNO_IF(EINVAL, Spec.size() != 65 || Spec[32] != ':' || !IsHex(Spec.substr(0, 32)) || !IsHex(Spec.substr(33)));
+    std::vector<std::string_view> Fields;
+    for (size_t Start = 0; Fields.size() < 6;)
+    {
+        const auto End = Fields.size() == 5 ? Spec.npos : Spec.find(':', Start);
+        THROW_ERRNO_IF(EINVAL, End == Spec.npos && Fields.size() != 5);
+        Fields.push_back(Spec.substr(Start, End == Spec.npos ? Spec.npos : End - Start));
+        Start = End + 1;
+    }
+
+    THROW_ERRNO_IF(EINVAL, !IsHex(Fields[0]) || !IsHex(Fields[1]) || Fields[5].empty() || Fields[5].find(':') != Fields[5].npos);
 
-    const std::string ExpectedPartUuid{Spec.substr(0, 32)};
-    const std::string ExpectedUuid{Spec.substr(33)};
+    const std::string ExpectedPartUuid{Fields[0]};
+    const std::string ExpectedUuid{Fields[1]};
+    const uint32_t ExpectedCompat = ToMask(Fields[2]);
+    const uint32_t ExpectedIncompat = ToMask(Fields[3]);
+    const uint32_t ExpectedRoCompat = ToMask(Fields[4]);
+
+    //
+    // The ext4 gate was reviewed against one kernel; a different kernel needs a new review before RW.
+    //
+
+    utsname Kernel{};
+    THROW_LAST_ERROR_IF(uname(&Kernel) < 0);
+    if (Fields[5] != Kernel.release)
+    {
+        LOG_ERROR("Physical root gate was reviewed for kernel {}, running {}", Fields[5], Kernel.release);
+        THROW_ERRNO(EPERM);
+    }
 
     //
     // Locate the GPT slot with the authorized PARTUUID. Linux names partitions after their slot index, which can
@@ -3892,6 +3926,41 @@ try
             LOG_ERROR("Physical root {} does not have the authorized ext4 superblock", DevicePath);
             THROW_ERRNO(EINVAL);
         }
+
+        //
+        // The on-disk feature masks must equal the reviewed ones. Journal recovery (INCOMPAT_RECOVER) and orphan
+        // processing (RO_COMPAT_ORPHAN_PRESENT) are runtime state left by an unclean shutdown, not features.
+        //
+
+        constexpr uint32_t IncompatRecover = 0x4;
+        constexpr uint32_t RoCompatOrphanPresent = 0x10000;
+        const auto Read32 = [&](size_t Offset) {
+            uint32_t Value{};
+            memcpy(&Value, Superblock.data() + Offset, sizeof(Value));
+            return Value;
+        };
+
+        const uint32_t Compat = Read32(0x5c);
+        const uint32_t Incompat = Read32(0x60);
+        const uint32_t RoCompat = Read32(0x64);
+        if (Compat != ExpectedCompat || (Incompat & ~IncompatRecover) != ExpectedIncompat ||
+            (RoCompat & ~RoCompatOrphanPresent) != ExpectedRoCompat)
+        {
+            LOG_ERROR(
+                "Physical root ext4 features {:08x}/{:08x}/{:08x} differ from the reviewed gate {:08x}/{:08x}/{:08x}",
+                Compat,
+                Incompat,
+                RoCompat,
+                ExpectedCompat,
+                ExpectedIncompat,
+                ExpectedRoCompat);
+            THROW_ERRNO(EPERM);
+        }
+
+        if ((Incompat & IncompatRecover) || (RoCompat & RoCompatOrphanPresent))
+        {
+            LOG_WARNING("Physical root {} was not shut down cleanly; the kernel will replay its journal", DevicePath);
+        }
     }
 
     THROW_LAST_ERROR_IF(UtilMount(DevicePath.c_str(), Target, FsType, 0, Options, c_defaultRetryTimeout) < 0);
diff --git a/src/windows/service/exe/LxssCreateProcess.h b/src/windows/service/exe/LxssCreateProcess.h
index 3a11fbf..dcfe79b 100644
--- a/src/windows/service/exe/LxssCreateProcess.h
+++ b/src/windows/service/exe/LxssCreateProcess.h
@@ -131,6 +131,11 @@ typedef struct _LXSS_PHYSICAL_ROOT
     GUID PartitionGuid;
     std::string Ext4Uuid; // 32 lowercase hex digits, no separators.
     std::wstring UserSid;
+    // Reviewed ext4 gate: exact on-disk feature masks and the WSL kernel release they were reviewed against.
+    DWORD Ext4Compat;
+    DWORD Ext4Incompat;
+    DWORD Ext4RoCompat;
+    std::string KernelRelease;
     bool Valid; // False when the HKLM key exists but is unreadable or incomplete; launch is then refused.
 } LXSS_PHYSICAL_ROOT;
 
diff --git a/src/windows/service/exe/LxssUserSession.cpp b/src/windows/service/exe/LxssUserSession.cpp
index 70da5b5..d892f1c 100644
--- a/src/windows/service/exe/LxssUserSession.cpp
+++ b/src/windows/service/exe/LxssUserSession.cpp
@@ -940,6 +940,8 @@ HRESULT LxssUserSessionImpl::MoveDistribution(_In_ LPCGUID DistroGuid, _In_ LPCW
 
     auto registration = DistributionRegistration::Open(lxssKey.get(), *DistroGuid);
     auto distro = s_GetDistributionConfiguration(registration);
+    // X1: image operations never apply to a physical root.
+    RETURN_HR_IF_MSG(E_NOTIMPL, distro.PhysicalRoot.has_value(), "X1 physical root: VHD operation refused");
 
     RETURN_HR_IF(E_NOTIMPL, WI_IsFlagClear(distro.Flags, LXSS_DISTRO_FLAGS_VM_MODE));
 
@@ -1077,6 +1079,8 @@ HRESULT LxssUserSessionImpl::ExportDistribution(_In_opt_ LPCGUID DistroGuid, _In
 
         // Ensure the distribution is installed.
         configuration = s_GetDistributionConfiguration(registration);
+        // X1: image operations never apply to a physical root.
+        RETURN_HR_IF_MSG(E_NOTIMPL, configuration.PhysicalRoot.has_value(), "X1 physical root: VHD operation refused");
         RETURN_HR_IF(E_ILLEGAL_STATE_CHANGE, (configuration.State != LxssDistributionStateInstalled));
 
         // Exporting a WSL1 distro is not possible if the VHD flag is specified.
@@ -1771,6 +1775,8 @@ try
 
     const auto registration = DistributionRegistration::Open(lxssKey.get(), *DistroGuid);
     LXSS_DISTRO_CONFIGURATION configuration = s_GetDistributionConfiguration(registration);
+    // X1: image operations never apply to a physical root.
+    RETURN_HR_IF_MSG(E_NOTIMPL, configuration.PhysicalRoot.has_value(), "X1 physical root: VHD operation refused");
 
     // Don't attempt on V1
     if (WI_IsFlagClear(configuration.Flags, LXSS_DISTRO_FLAGS_VM_MODE))
@@ -1818,6 +1824,8 @@ try
     const wil::unique_hkey lxssKey = s_OpenLxssUserKey(userToken.get());
     const auto registration = DistributionRegistration::Open(lxssKey.get(), *DistroGuid);
     const auto configuration = s_GetDistributionConfiguration(registration);
+    // X1: image operations never apply to a physical root.
+    RETURN_HR_IF_MSG(E_NOTIMPL, configuration.PhysicalRoot.has_value(), "X1 physical root: VHD operation refused");
     RETURN_HR_IF(WSL_E_WSL2_NEEDED, WI_IsFlagClear(configuration.Flags, LXSS_DISTRO_FLAGS_VM_MODE));
 
     // Fail if a conversion or export is in progress; those operations release m_instanceLock while
@@ -1882,6 +1890,8 @@ try
         const wil::unique_hkey lxssKey = s_OpenLxssUserKey(userToken.get());
         const auto registration = DistributionRegistration::Open(lxssKey.get(), *DistroGuid);
         configuration = s_GetDistributionConfiguration(registration);
+        // X1: image operations never apply to a physical root.
+        RETURN_HR_IF_MSG(E_NOTIMPL, configuration.PhysicalRoot.has_value(), "X1 physical root: VHD operation refused");
         RETURN_HR_IF(WSL_E_WSL2_NEEDED, WI_IsFlagClear(configuration.Flags, LXSS_DISTRO_FLAGS_VM_MODE));
 
         vhdPath = configuration.VhdFilePath;
@@ -1936,6 +1946,8 @@ HRESULT LxssUserSessionImpl::SetVersion(_In_ LPCGUID DistroGuid, _In_ ULONG Vers
         std::lock_guard lock(m_instanceLock);
         registration = DistributionRegistration::Open(lxssKey.get(), *DistroGuid);
         configuration = s_GetDistributionConfiguration(registration);
+        // X1: image operations never apply to a physical root.
+        RETURN_HR_IF_MSG(E_NOTIMPL, configuration.PhysicalRoot.has_value(), "X1 physical root: VHD operation refused");
 
         // The distro must be in the installed state.
         RETURN_HR_IF(E_ILLEGAL_STATE_CHANGE, (configuration.State != LxssDistributionStateInstalled));
@@ -4193,9 +4205,16 @@ LxssUserSessionImpl::s_GetDistributionConfiguration(const DistributionRegistrati
                 physical.UserSid = read(L"UserSid");
                 const auto partitionGuid = wsl::shared::string::ToGuid(read(L"PartitionGuid"));
                 physical.Ext4Uuid = wsl::windows::common::string::WideToMultiByte(read(L"Ext4Uuid"));
+                physical.Ext4Compat = wsl::windows::common::registry::ReadDword(physicalKey.get(), nullptr, L"Ext4Compat", 0);
+                physical.Ext4Incompat = wsl::windows::common::registry::ReadDword(physicalKey.get(), nullptr, L"Ext4Incompat", 0);
+                physical.Ext4RoCompat = wsl::windows::common::registry::ReadDword(physicalKey.get(), nullptr, L"Ext4RoCompat", 0);
+                physical.KernelRelease = wsl::windows::common::string::WideToMultiByte(read(L"KernelRelease"));
                 physical.Valid = partitionGuid.has_value() && !physical.Model.empty() && !physical.Serial.empty() &&
                                  !physical.UserSid.empty() && physical.Ext4Uuid.size() == 32 &&
-                                 std::ranges::all_of(physical.Ext4Uuid, [](char c) { return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'); });
+                                 std::ranges::all_of(physical.Ext4Uuid, [](char c) { return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'); }) &&
+                                 physical.Ext4Compat != 0 && physical.Ext4Incompat != 0 && physical.Ext4RoCompat != 0 &&
+                                 !physical.KernelRelease.empty() && physical.KernelRelease.size() < 128 &&
+                                 std::ranges::all_of(physical.KernelRelease, [](char c) { return std::isalnum(static_cast<unsigned char>(c)) || c == '.' || c == '-' || c == '_' || c == '+'; });
 
                 physical.PartitionGuid = partitionGuid.value_or(GUID{});
             }
diff --git a/src/windows/service/exe/WslCoreVm.cpp b/src/windows/service/exe/WslCoreVm.cpp
index d41bac7..f96e6bf 100644
--- a/src/windows/service/exe/WslCoreVm.cpp
+++ b/src/windows/service/exe/WslCoreVm.cpp
@@ -1367,10 +1367,22 @@ std::shared_ptr<LxssRunningInstance> WslCoreVm::CreateInstance(
         // The administrator-owned HKLM authorization, bound to this user and to the disk identity, stands in for the
         // per-call elevation that wsl --mount requires, so identity resolution and the pass-through attach run as the
         // service rather than with the (possibly unelevated) user token.
-        // N.B. Spike limitation: a failed launch leaves the disk attached until the VM shuts down.
         auto runAsSelf = wil::run_as_self();
         const auto diskPath = ResolvePhysicalRoot(root);
-        lun = AttachDiskLockHeld(diskPath.c_str(), DiskType::PassThrough, MountFlags::None, {}, false, nullptr);
+
+        // A terminated instance of this distro leaves its root attached until the VM stops (as a distro VHD does).
+        // Reuse that LUN; a disk attached by wsl --mount (User) is never taken over.
+        // N.B. A failed launch also leaves the disk attached; the next launch reuses it the same way.
+        const auto attached = m_attachedDisks.find({DiskType::PassThrough, diskPath});
+        if (attached != m_attachedDisks.end())
+        {
+            THROW_HR_IF(WSL_E_DISK_ALREADY_ATTACHED, attached->first.User);
+            lun = attached->second.Lun;
+        }
+        else
+        {
+            lun = AttachDiskLockHeld(diskPath.c_str(), DiskType::PassThrough, MountFlags::None, {}, false, nullptr);
+        }
 
         // The PARTUUID travels as its on-disk GPT bytes; GUID memory layout matches the GPT entry layout.
         const auto* partitionBytes = reinterpret_cast<const uint8_t*>(&root.PartitionGuid);
@@ -1379,7 +1391,8 @@ std::shared_ptr<LxssRunningInstance> WslCoreVm::CreateInstance(
             physicalRoot += std::format("{:02x}", partitionBytes[index]);
         }
 
-        physicalRoot += std::format(":{}", root.Ext4Uuid);
+        physicalRoot += std::format(
+            ":{}:{:08x}:{:08x}:{:08x}:{}", root.Ext4Uuid, root.Ext4Compat, root.Ext4Incompat, root.Ext4RoCompat, root.KernelRelease);
     }
     else
     {

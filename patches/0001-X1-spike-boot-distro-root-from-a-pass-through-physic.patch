+int MountPhysicalRoot(unsigned int Lun, const char* PhysicalRoot, const char* Target, const char* FsType, const char* Options)
+
+/*++
+
+Routine Description:
+
+    X1: mounts the root partition of a pass-through physical disk. The service already matched the disk identity and
+    PARTUUID on Windows; this routine checks the ext4 superblock UUID before mounting and the mount source after.
+
+Arguments:
+
+    Lun - Supplies the LUN of the pass-through disk.
+
+    PhysicalRoot - Supplies "<partition number>:<ext4 uuid as 32 lowercase hex digits>".
+
+    Target - Supplies the target of the mount.
+
+    FsType - Supplies the filesystem type.
+
+    Options - Supplies mount options.
+
+Return Value:
+
+    0 on success, < 0 on failure.
+
+--*/
+
+try
+{
+    const std::string_view Spec{PhysicalRoot};
+    const auto Separator = Spec.find(':');
+    THROW_ERRNO_IF(EINVAL, Separator == Spec.npos || Separator == 0 || Spec.size() - Separator - 1 != 32);
+
+    const auto Partition = std::stoul(std::string{Spec.substr(0, Separator)});
+    const std::string ExpectedUuid{Spec.substr(Separator + 1)};
+    THROW_ERRNO_IF(EINVAL, Partition == 0);
+
+    const auto DevicePath = std::format("{}{}", GetLunDevicePath(Lun), Partition);
+    WaitForBlockDevice(DevicePath.c_str());
+
+    {
+        wil::unique_fd Device{open(DevicePath.c_str(), (O_RDONLY | O_CLOEXEC))};
+        THROW_LAST_ERROR_IF(!Device);
+
+        std::array<uint8_t, 1024> Superblock{};
+        THROW_ERRNO_IF(EIO, pread(Device.get(), Superblock.data(), Superblock.size(), 1024) != static_cast<ssize_t>(Superblock.size()));
+
+        const uint16_t Magic = Superblock[0x38] | (Superblock[0x39] << 8);
+        std::string Uuid;
+        for (size_t Index = 0; Index < 16; Index++)
+        {
+            Uuid += std::format("{:02x}", Superblock[0x68 + Index]);
+        }
+
+        if (Magic != 0xEF53 || Uuid != ExpectedUuid)
+        {
+            LOG_ERROR("Physical root {} does not have the authorized ext4 superblock", DevicePath);
+            THROW_ERRNO(EINVAL);
+        }
+    }
+
+    THROW_LAST_ERROR_IF(UtilMount(DevicePath.c_str(), Target, FsType, 0, Options, c_defaultRetryTimeout) < 0);
+
+    struct stat DeviceStat{};
+    struct stat TargetStat{};
+    THROW_LAST_ERROR_IF(stat(DevicePath.c_str(), &DeviceStat) < 0);
+    THROW_LAST_ERROR_IF(stat(Target, &TargetStat) < 0);
+    if (TargetStat.st_dev != DeviceStat.st_rdev)
+    {
+        LOG_ERROR("Physical root mount source mismatch for {}", Target);
+        umount(Target);
+        THROW_ERRNO(EIO);
+    }
+
+    return 0;
+}
+CATCH_RETURN_ERRNO()

 using wsl::windows::common::ExecutionContext;
 
 namespace {
+
+// X1: GPT partition type of a Linux filesystem.
+constexpr GUID c_linuxFilesystemPartitionType = {0x0fc63daf, 0x8483, 0x4772, {0x8e, 0x79, 0x3d, 0x69, 0xd8, 0x47, 0x7d, 0xe4}};
+
+std::wstring GetTokenSidString(_In_ HANDLE Token)
+{
+    const auto user = wil::get_token_information<TOKEN_USER>(Token);
+    wil::unique_hlocal_string sid;
+    THROW_IF_WIN32_BOOL_FALSE(ConvertSidToStringSidW(user->User.Sid, &sid));
+    return sid.get();
+}
+
+std::wstring ReadDescriptorString(_In_ const std::vector<BYTE>& Buffer, _In_ DWORD Size, _In_ DWORD Offset)
+{
+    if (Offset == 0 || Offset >= Size)
+    {
+        return {};
+    }
+
+    std::string value(reinterpret_cast<const char*>(Buffer.data() + Offset), strnlen(reinterpret_cast<const char*>(Buffer.data() + Offset), Size - Offset));
+    const auto first = value.find_first_not_of(' ');
+    const auto last = value.find_last_not_of(' ');
+    return first == std::string::npos ? std::wstring{} : wsl::shared::string::MultiByteToWide(value.substr(first, last - first + 1));
+}
+
+// X1: resolve the authorized identity to a transient \\.\PhysicalDriveN path and GPT partition number.
+// The disk must match model and serial exactly once, must not hold the Windows directory, and must contain exactly
+// one partition with the authorized PARTUUID and the Linux filesystem type.
+std::pair<std::wstring, ULONG> ResolvePhysicalRoot(_In_ const LXSS_PHYSICAL_ROOT& Root)
+{
+    DWORD systemDisk{};
+    {
+        wchar_t windowsDirectory[MAX_PATH]{};
+        THROW_LAST_ERROR_IF(GetSystemWindowsDirectoryW(windowsDirectory, ARRAYSIZE(windowsDirectory)) == 0);
+        const auto volumePath = std::format(L"\\\\.\\{}:", windowsDirectory[0]);
+        const wil::unique_hfile volume{
+            CreateFileW(volumePath.c_str(), 0, FILE_SHARE_READ | FILE_SHARE_WRITE, nullptr, OPEN_EXISTING, 0, nullptr)};
+        THROW_LAST_ERROR_IF(!volume);
+
+        VOLUME_DISK_EXTENTS extents{};
+        DWORD bytes{};
+        THROW_IF_WIN32_BOOL_FALSE(DeviceIoControl(
+            volume.get(), IOCTL_VOLUME_GET_VOLUME_DISK_EXTENTS, nullptr, 0, &extents, sizeof(extents), &bytes, nullptr));
+        THROW_HR_IF(E_UNEXPECTED, extents.NumberOfDiskExtents != 1);
+        systemDisk = extents.Extents[0].DiskNumber;
+    }
+
+    std::optional<std::pair<std::wstring, ULONG>> match;
+    for (DWORD index = 0; index < 64; index++)
+    {
+        auto path = std::format(L"\\\\.\\PhysicalDrive{}", index);
+        const wil::unique_hfile disk{
+            CreateFileW(path.c_str(), GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, nullptr, OPEN_EXISTING, 0, nullptr)};
+        if (!disk)
+        {
+            continue;
+        }
+
+        STORAGE_PROPERTY_QUERY query{StorageDeviceProperty, PropertyStandardQuery};
+        std::vector<BYTE> descriptor(4096);
+        DWORD bytes{};
+        if (!DeviceIoControl(
+                disk.get(), IOCTL_STORAGE_QUERY_PROPERTY, &query, sizeof(query), descriptor.data(), static_cast<DWORD>(descriptor.size()), &bytes, nullptr))
+        {
+            continue;
+        }
+
+        const auto* header = reinterpret_cast<const STORAGE_DEVICE_DESCRIPTOR*>(descriptor.data());
+        if (ReadDescriptorString(descriptor, bytes, header->ProductIdOffset) != Root.Model ||
+            ReadDescriptorString(descriptor, bytes, header->SerialNumberOffset) != Root.Serial)
+        {
+            continue;
+        }
+
+        THROW_HR_IF_MSG(E_UNEXPECTED, match.has_value(), "X1 physical root identity matches more than one disk");
+
+        STORAGE_DEVICE_NUMBER number{};
+        THROW_IF_WIN32_BOOL_FALSE(DeviceIoControl(
+            disk.get(), IOCTL_STORAGE_GET_DEVICE_NUMBER, nullptr, 0, &number, sizeof(number), &bytes, nullptr));
+        THROW_HR_IF_MSG(E_ACCESSDENIED, number.DeviceNumber == systemDisk, "X1 physical root identity matches the Windows disk");
+
+        std::vector<BYTE> layoutBuffer(64 * 1024);
+        THROW_IF_WIN32_BOOL_FALSE(DeviceIoControl(
+            disk.get(), IOCTL_DISK_GET_DRIVE_LAYOUT_EX, nullptr, 0, layoutBuffer.data(), static_cast<DWORD>(layoutBuffer.size()), &bytes, nullptr));
+
+        const auto* layout = reinterpret_cast<const DRIVE_LAYOUT_INFORMATION_EX*>(layoutBuffer.data());
+        THROW_HR_IF_MSG(E_UNEXPECTED, layout->PartitionStyle != PARTITION_STYLE_GPT, "X1 physical root disk is not GPT");
+
+        std::optional<ULONG> partitionNumber;
+        for (DWORD entry = 0; entry < layout->PartitionCount; entry++)
+        {
+            const auto& partition = layout->PartitionEntry[entry];
+            if (partition.PartitionStyle == PARTITION_STYLE_GPT && IsEqualGUID(partition.Gpt.PartitionId, Root.PartitionGuid))
+            {
+                THROW_HR_IF_MSG(E_UNEXPECTED, partitionNumber.has_value(), "X1 PARTUUID is duplicated");
+                THROW_HR_IF_MSG(
+                    E_UNEXPECTED,
+                    !IsEqualGUID(partition.Gpt.PartitionType, c_linuxFilesystemPartitionType),
+                    "X1 root partition is not a Linux filesystem partition");
+
+                partitionNumber = partition.PartitionNumber;
+            }
+        }
+
+        THROW_HR_IF_MSG(E_NOT_SET, !partitionNumber.has_value() || partitionNumber.value() == 0, "X1 root partition not found");
+        match.emplace(std::move(path), partitionNumber.value());
+    }
+
+    THROW_HR_IF_MSG(E_NOT_SET, !match.has_value(), "X1 physical root disk not found");
+    return match.value();
+}
